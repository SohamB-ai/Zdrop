ZDROP_STORAGE=local

# Required for Supabase mode (default on Vercel):
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firestore profiles and shop visitors (also used by optional Firebase file storage):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
FIREBASE_WEB_API_KEY=

# Secrets
CRON_SECRET=
RATE_LIMIT_SECRET=
ZDROP_AUTH_SECRET=

# Set true only when your reverse proxy overwrites x-forwarded-for.
ZDROP_TRUST_PROXY=false

# Clerk authentication (enable Google as a social connection)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
