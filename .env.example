ZDROP_STORAGE=local
# Set to firestore for hosted uploads up to 768 KiB per file on the Spark plan.
ZDROP_FILE_STORAGE=

# Firestore metadata and Firebase Storage documents:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
FIREBASE_WEB_API_KEY=

# Secrets
CRON_SECRET=
RATE_LIMIT_SECRET=
ZDROP_AUTH_SECRET=

# Set true only when your reverse proxy overwrites x-forwarded-for.
ZDROP_TRUST_PROXY=false

# Clerk authentication (enable Google as a social connection)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
